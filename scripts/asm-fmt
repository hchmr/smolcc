#!/usr/bin/env python3

import re
import sys

for line in sys.stdin:
    line = line.strip()

    m = re.fullmatch(r'(?:(//.*)|("(?:\\.|[^"\\])*")|.)*', line)
    if m and m.group(1):
        comment = m.group(1)
        line = line[: m.start(1)].rstrip()
    else:
        comment = ""

    if not line:
        pass
    elif line.startswith(".") or line.endswith(":"):
        pass
    elif line[0].isalnum():
        parts = line.split(None, 1)
        mnemonic = parts[0]
        operands = parts[1] if len(parts) > 1 else ""
        line = f"    {mnemonic:<8}{operands}"

    print(f"{line:<40}{comment}".rstrip())
