#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
    echo "Usage: $0 [options] <file.c>"
}

help() {
    usage
    cat <<EOF
Options:
    -l <file>  Link with specified library
    -h         Show this help message
EOF
}

arg_error() {
    echo "Error: $1"
    usage
    exit 1
}

source_file=
link_libs=()

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -h|--help)
        help; exit 0 ;;
        -l)
            if [[ -z "${2:-}" ]]; then
                arg_error "Option -l requires an argument"
            fi
            link_libs+=("$2")
            shift 2 ;;
        --) shift; break ;;
        *)
        if [[ -z "$source_file" ]]; then
            source_file="$1"
        else
            arg_error "Unexpected argument: $1"
        fi
        shift ;;
    esac
done

if [[ -z "$source_file" ]]; then
    arg_error "No source file specified"
fi

tmp_root="${TMPDIR:-/tmp}"
build_dir=$(mktemp -d "${tmp_root%/}/smolcc-run.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT

output_file="$build_dir/a.out"

./scripts/compile -o "$output_file" "$source_file" "${link_libs[@]}"

"$output_file" "$@"
