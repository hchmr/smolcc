#!/usr/bin/env bash

set -Eeuo pipefail

run() {
    echo "$@"
    eval "$@"
}

cc=${CC:-cc}

run "rm -rf out"
run "mkdir -p out/1 out/2"

# stage 0: use host toolchain
make -f stage0.mk

# stage 1: self-compile with stage 0 compiler
run "./out/0/smolcc < src/smolcc.c | ./scripts/asm-fmt > out/1/smolcc.s"
run "$cc -nostdlib -o out/1/smolcc out/1/smolcc.s src/sys.s"

# stage 2: self-compile with stage 1 compiler
run "./out/1/smolcc < src/smolcc.c | ./scripts/asm-fmt > out/2/smolcc.s"
run "diff -u out/1/smolcc.s out/2/smolcc.s"
run "$cc -nostdlib -o out/2/smolcc out/2/smolcc.s src/sys.s"

echo "PASS"
