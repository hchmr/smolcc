#!/usr/bin/env python3

import argparse
import asyncio
from dataclasses import dataclass
from difflib import unified_diff
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
from typing import TextIO
import enum

GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
RESET = "\033[0m"


CC = "build/dist/bin/smolcc"
CFLAGS: list[str] = []


class Verbosity(enum.IntEnum):
    NORMAL = 0
    VERBOSE = 1
    DEBUG = 2


verbosity = Verbosity.NORMAL


################################################################################
# Spec


DIRECTIVE_NAMES = {"description", "mode", "file", "args", "exit", "stderr", "stdout"}


class SpecMode(enum.Enum):
    COMPILE_ONLY = "compile-only"
    RUN = "run"

    @staticmethod
    def try_from_str(value: str) -> "SpecMode | None":
        if value not in {mode.value for mode in SpecMode}:
            return None
        return SpecMode(value)


@dataclass
class Spec:
    file_type: str
    file: Path | None
    description: str | None
    args: str | None
    mode: SpecMode | None
    exit_code: int | None
    stderr: str | None
    stdout: str | None
    body: str


def directive_prefix(file_type: str) -> str:
    if file_type != "c":
        return ""
    return "//#"


def parse_directive(file_type: str, line: str) -> tuple[str, str] | None:
    prefix_pat = directive_prefix(file_type)
    directive_pat = rf"{prefix_pat}\s*(\w+)\s*:\s?(.*)"

    if not (match := re.fullmatch(directive_pat, line)):
        return None
    return match.group(1), match.group(2)


def parse_line_val(path: Path, lineno: int, kind: str, value: str) -> str:
    if not value.startswith('"'):
        return value

    try:
        line = json.loads(value)
    except json.JSONDecodeError as exc:
        raise SystemExit(
            f"{path}:{lineno}: invalid {kind} directive {value!r}: {exc.msg}"
        )

    if not isinstance(line, str):
        raise SystemExit(f"{path}:{lineno}: {kind} directive must decode to a string")

    return line


def parse_spec(path: Path, lines: list[str]) -> Spec:
    file_type = path.suffix.lstrip(".")
    description = None
    file = None
    args = None
    mode = None
    exit_code = None
    stderr_parts: list[str] = []
    stdout_parts: list[str] = []
    body_parts: list[str] = []
    for lineno, raw_line in enumerate(lines, start=1):
        directive = parse_directive(file_type, raw_line.rstrip("\n"))

        match directive:
            case ("description", value) if description is None:
                description = value
            case ("file", value) if file is None:
                file = Path(value)
            case ("args", value) if args is None:
                args = value
            case ("mode", value) if mode is None:
                if not (mode := SpecMode.try_from_str(value)):
                    raise SystemExit(
                        f"{path}:{lineno}: unsupported test mode {value!r}"
                    )
            case ("exit", value) if exit_code is None:
                exit_code = int(value)
            case ("stderr", value):
                stderr_parts.append(parse_line_val(path, lineno, "stderr", value))
            case ("stdout", value):
                stdout_parts.append(parse_line_val(path, lineno, "stdout", value))
            case (other, _):
                print(
                    f"{path}:{lineno}: warning: invalid directive {other!r} (ignored)",
                    file=sys.stderr,
                )
            case _:
                body_parts.append(raw_line)

    if file is None and file_type != "c":
        raise SystemExit(f"{path}: missing required file directive")

    return Spec(
        file_type=file_type,
        file=file,
        description=description,
        args=args,
        mode=mode,
        exit_code=exit_code,
        stderr="\n".join(stderr_parts) if stderr_parts else None,
        stdout="\n".join(stdout_parts) if stdout_parts else None,
        body="".join(body_parts),
    )


def unparse_line_val(line: str) -> str:
    if (
        line.startswith('"')
        or all(c.isspace() for c in line)
        or any(not (32 <= ord(c) <= 126) for c in line)
    ):
        return json.dumps(line)
    else:
        return line


def unparse_spec(spec: Spec) -> list[str]:
    directives: list[tuple[str, str]] = []

    if spec.description is not None:
        directives.append(("description", spec.description))
    if spec.file is not None:
        directives.append(("file", str(spec.file)))
    if spec.mode is not None:
        directives.append(("mode", spec.mode.value))
    if spec.args is not None:
        directives.append(("args", spec.args))
    if spec.exit_code is not None:
        directives.append(("exit", str(spec.exit_code)))
    if spec.stderr is not None:
        for line in spec.stderr.splitlines():
            directives.append(("stderr", unparse_line_val(line)))
    if spec.stdout is not None:
        for line in spec.stdout.splitlines():
            directives.append(("stdout", unparse_line_val(line)))

    prefix = (directive_prefix(spec.file_type) + " ").lstrip()
    lines = [f"{prefix}{name}: {value}\n" for name, value in directives]
    lines.append(spec.body)

    return lines


def read_spec(path: Path) -> Spec:
    lines = path.read_text().splitlines(keepends=True)
    return parse_spec(path, lines)


def update_spec(
    path: Path, spec: Spec, result: subprocess.CompletedProcess[str]
) -> None:
    if spec.exit_code is not None:
        spec.exit_code = result.returncode
    if spec.exit_code == default_exit_for(path):
        spec.exit_code = None
    if spec.stderr is not None:
        spec.stderr = result.stderr
    if spec.stdout is not None:
        spec.stdout = result.stdout
    path.write_text("".join(unparse_spec(spec)))


################################################################################
# Test runner


def print_text_block(label: str, text: str) -> None:
    print(f"{label}:")
    if text:
        print(text, end="" if text.endswith("\n") else "\n")
    else:
        print("<empty>")
    print()


def print_text_diff(expected: str, actual: str, label: str) -> None:
    expected_lines = expected.splitlines()
    actual_lines = actual.splitlines()
    diff = unified_diff(
        expected_lines,
        actual_lines,
        fromfile=f"expected {label}",
        tofile=f"actual {label}",
    )
    print("\n".join(diff) or "<no difference>")


def default_exit_for(path: Path) -> int:
    return 1 if "bad" in path.parts else 0


async def live_output(proc: asyncio.subprocess.Process):
    assert proc.stdout and proc.stderr

    # Helper function to read a stream and write to terminal in real-time
    async def stream_and_capture(
        reader: asyncio.StreamReader, terminal_stream: TextIO
    ) -> str:
        chunks: list[str] = []
        while line := await reader.readline():
            line = line.decode()
            terminal_stream.write(line)
            terminal_stream.flush()
            chunks.append(line)
        return "".join(chunks)

    # Runs both stream readers concurrently using the event loop
    stdout_task = asyncio.create_task(stream_and_capture(proc.stdout, sys.stdout))
    stderr_task = asyncio.create_task(stream_and_capture(proc.stderr, sys.stderr))

    # Wait for everything to finish
    return await asyncio.gather(stdout_task, stderr_task)


async def run_async(
    args: list[str], check: bool = False
) -> subprocess.CompletedProcess[str]:
    if verbosity >= Verbosity.VERBOSE:
        print("+", shlex.join(args))

    proc = await asyncio.create_subprocess_exec(
        *args,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    if verbosity >= Verbosity.DEBUG:
        stdout_str, stderr_str = await live_output(proc)
        await proc.wait()
    else:
        stdout_bytes, stderr_bytes = await proc.communicate()
        stdout_str, stderr_str = stdout_bytes.decode(), stderr_bytes.decode()

    assert proc.returncode is not None
    if check and proc.returncode != 0:
        raise subprocess.CalledProcessError(
            proc.returncode, args, stdout_str, stderr_str
        )

    return subprocess.CompletedProcess(args, proc.returncode, stdout_str, stderr_str)


def run(args: list[str], check: bool = False) -> subprocess.CompletedProcess[str]:
    return asyncio.run(run_async(args, check=check))


def run_file(
    path: Path, mode: SpecMode, args: list[str]
) -> subprocess.CompletedProcess[str]:
    with tempfile.TemporaryDirectory(
        prefix="smolcc-test-", dir=os.environ.get("TMPDIR") or None
    ) as temp_dir:
        match mode:
            case SpecMode.COMPILE_ONLY:
                output_path = Path(temp_dir) / "a.o"
                return run([CC, *CFLAGS, "-c", "-o", str(output_path), str(path)])
            case SpecMode.RUN:
                output_path = Path(temp_dir) / "a.out"
                compile_result = run([CC, *CFLAGS, "-o", str(output_path), str(path)])
                if compile_result.returncode != 0:
                    return compile_result
                return run([str(output_path), *args])


def collect_case_groups(paths: list[Path]) -> list[list[Path]]:
    if paths:
        return [paths]

    def walk():
        for dirpath, _, filenames in os.walk("tests"):
            for filename in filenames:
                if filename.endswith((".snap.txt", ".c")):
                    yield Path(dirpath) / filename

    return [sorted(walk())]


def run_case(path: Path, update: bool) -> bool:
    print(f"==> {path} ", end="", flush=True)
    if verbosity >= Verbosity.VERBOSE:
        print()

    spec = read_spec(path)
    mode = spec.mode or SpecMode.COMPILE_ONLY
    args = shlex.split(spec.args) if spec.args else []
    src_path = spec.file or path
    result = run_file(src_path, mode, args)

    if update:
        update_spec(path, spec, result)
        print(f"{YELLOW}UPDATED{RESET}")
        return True

    want_exit = spec.exit_code
    if want_exit is None:
        want_exit = default_exit_for(path)

    actual_stderr = result.stderr.rstrip("\n")
    actual_stdout = result.stdout.rstrip("\n")
    stderr_failure, stdout_failure = None, None
    if spec.stderr is not None and actual_stderr != spec.stderr:
        stderr_failure = (spec.stderr, actual_stderr)
    if (
        mode == SpecMode.RUN
        and spec.stdout is not None
        and actual_stdout != spec.stdout
    ):
        stdout_failure = (spec.stdout, actual_stdout)

    if result.returncode != want_exit or stderr_failure or stdout_failure:
        print(f"{RED}FAIL{RESET}")

        if result.returncode != want_exit:
            print(f"Expected exit code: {want_exit}")
            print(f"Actual exit code:   {result.returncode}\n")

        if stderr_failure:
            print_text_diff(*stderr_failure, "stderr")
        else:
            print_text_block("stderr", actual_stderr)

        if stdout_failure:
            print_text_diff(*stdout_failure, "stdout")

        return False

    print(f"{GREEN}OK{RESET}")
    return True


def run_group(paths: list[Path], update: bool):
    n_passed, n_failed, n_skipped = 0, 0, 0
    for path in paths:
        if not path.exists():
            print(f"{YELLOW}SKIP{RESET} {path} (file not found)")
            n_skipped += 1
        elif run_case(path, update):
            n_passed += 1
        else:
            n_failed += 1
    return n_passed, n_failed, n_skipped


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "paths",
        nargs="*",
        type=Path,
        help="test files to run; defaults to the standard suite",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="rewrite expectations from the current compiler output",
    )
    parser.add_argument(
        "--stage",
        choices=["stage0", "stage1", "stage2"],
        help="which compiler stage to test (default: stage2)",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="skip building the compiler",
    )
    parser.add_argument(
        "--verbosity",
        choices=["normal", "verbose", "debug"],
        default="normal",
        help="set the verbosity level of test output (default: normal)",
    )

    args = parser.parse_args()
    if args.stage and args.no_build:
        print("error: --stage and --no-build cannot be used together", file=sys.stderr)
        sys.exit(1)

    args.stage = args.stage or "stage2"

    global verbosity
    verbosity = {
        "normal": Verbosity.NORMAL,
        "verbose": Verbosity.VERBOSE,
        "debug": Verbosity.DEBUG,
    }[args.verbosity]

    return args


def build_smolcc(args: argparse.Namespace):
    run(["make", "compiler", f"STAGE={args.stage}"], check=True)


def main() -> int:
    args = parse_args()

    if not args.no_build:
        build_smolcc(args)

    print("\n===> Running snapshot tests...\n")

    groups = collect_case_groups(args.paths)
    if not groups or not any(groups):
        print("No test cases found.")
        return 0

    n_passed, n_failed, n_skipped = 0, 0, 0
    for group in groups:
        passed, failed, skipped = run_group(group, args.update)
        n_passed += passed
        n_failed += failed
        n_skipped += skipped

    if args.update:
        print("\nExpectations updated.")
        return 0

    status = f"{GREEN}PASS{RESET}" if n_failed == 0 else f"{RED}FAIL{RESET}"
    print(f"\n{status}: {n_passed} passed, {n_failed} failed, {n_skipped} skipped.")
    return int(bool(n_failed))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
