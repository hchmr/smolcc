#!/usr/bin/env python3

import argparse
import asyncio
from dataclasses import dataclass
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
from typing import TextIO
import enum

GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
RESET = "\033[0m"


SMOLCC_PATH = Path("build") / "dist" / "bin" / "smolcc"


class Verbsity(enum.IntEnum):
    NORMAL = 0
    VERBOSE = 1
    DEBUG = 2


verbosity = Verbsity.NORMAL


@dataclass
class spec:
    description: str | None
    args: str | None
    mode: str | None
    exit_code: int | None
    stderr: str | None
    stdout: str | None
    body: str


def parse_directive(line: str) -> tuple[str, str] | None:
    match = re.fullmatch(
        r"\s*//\s*#\s*(description|args|mode|exit|stderr|stdout)\s*:\s?(.*)", line
    )
    if match is None:
        return None
    return match.group(1), match.group(2)


def parse_output_line(path: Path, kind: str, value: str) -> str:
    if not value.startswith('"'):
        return value

    try:
        line = json.loads(value)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{path}: invalid {kind} directive {value!r}: {exc.msg}")

    if not isinstance(line, str):
        raise SystemExit(f"{path}: {kind} directive must decode to a string")

    return line


def read_spec(path: Path) -> spec:
    lines = path.read_text().splitlines(keepends=True)

    description = None
    args = None
    mode = None
    exit_code = None
    stderr_parts: list[str] = []
    stdout_parts: list[str] = []
    body_parts: list[str] = []
    for raw_line in lines:
        directive = parse_directive(raw_line.rstrip("\n"))

        match directive:
            case ("description", value) if description is None:
                description = value
            case ("args", value) if args is None:
                args = value
            case ("mode", value) if mode is None:
                if value not in {"compile-only", "run"}:
                    raise SystemExit(f"{path}: unsupported test mode {value!r}")
                mode = value
            case ("exit", value) if exit_code is None:
                exit_code = int(value)
            case ("stderr", value):
                stderr_parts.append(parse_output_line(path, "stderr", value))
            case ("stdout", value):
                stdout_parts.append(parse_output_line(path, "stdout", value))
            case _:
                body_parts.append(raw_line)

    return spec(
        description=description,
        args=args,
        mode=mode,
        exit_code=exit_code,
        stderr="\n".join(stderr_parts) if stderr_parts else None,
        stdout="\n".join(stdout_parts) if stdout_parts else None,
        body="".join(body_parts),
    )


def format_output(prefix: str, text: str) -> list[str]:
    if not text:
        return []

    def should_quote(line: str) -> bool:
        if line.startswith('"'):
            return True
        return any(ord(ch) < 32 and ch != "\t" for ch in line)

    lines: list[str] = []
    for line in text.splitlines():
        rendered = json.dumps(line) if should_quote(line) else line
        lines.append(f"{prefix}{rendered}\n")
    return lines


def update_spec(
    path: Path, spec: spec, result: subprocess.CompletedProcess[str]
) -> None:
    lines: list[str] = []
    if spec.description is not None:
        lines.append(f"//# description: {spec.description}\n")
    if spec.mode is not None:
        lines.append(f"//# mode: {spec.mode}\n")
    if spec.args is not None:
        lines.append(f"//# args: {spec.args}\n")
    lines.append(f"//# exit: {result.returncode}\n")
    lines.extend(format_output("//# stderr: ", result.stderr))
    if spec.stdout is not None:
        lines.extend(format_output("//# stdout: ", result.stdout))
    lines.append(spec.body)
    path.write_text("".join(lines))


def print_text_block(label: str, text: str) -> None:
    print(f"{label}:")
    if text:
        print(text, end="" if text.endswith("\n") else "\n")
    else:
        print("<empty>")
    print()


def default_exit_for(path: Path) -> int:
    return 1 if "bad" in path.parts else 0


async def live_output(proc: asyncio.subprocess.Process):
    assert proc.stdout and proc.stderr

    # Helper function to read a stream and write to terminal in real-time
    async def stream_and_capture(
        reader: asyncio.StreamReader, terminal_stream: TextIO
    ) -> str:
        chunks: list[str] = []
        while line := await reader.readline():
            line = line.decode()
            terminal_stream.write(line)
            terminal_stream.flush()
            chunks.append(line)
        return "".join(chunks)

    # Runs both stream readers concurrently using the event loop
    stdout_task = asyncio.create_task(stream_and_capture(proc.stdout, sys.stdout))
    stderr_task = asyncio.create_task(stream_and_capture(proc.stderr, sys.stderr))

    # Wait for everything to finish
    return await asyncio.gather(stdout_task, stderr_task)


async def run_async(
    args: list[str], check: bool = False
) -> subprocess.CompletedProcess[str]:
    if verbosity >= Verbsity.VERBOSE:
        print("+", shlex.join(args))

    proc = await asyncio.create_subprocess_exec(
        *args,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    if verbosity >= Verbsity.DEBUG:
        stdout_str, stderr_str = await live_output(proc)
        await proc.wait()
    else:
        stdout_bytes, stderr_bytes = await proc.communicate()
        stdout_str, stderr_str = stdout_bytes.decode(), stderr_bytes.decode()

    assert proc.returncode is not None
    if check and proc.returncode != 0:
        raise subprocess.CalledProcessError(
            proc.returncode, args, stdout_str, stderr_str
        )

    return subprocess.CompletedProcess(args, proc.returncode, stdout_str, stderr_str)


def run(args: list[str], check: bool = False) -> subprocess.CompletedProcess[str]:
    return asyncio.run(run_async(args, check=check))


def run_command(
    path: Path, mode: str, args: list[str]
) -> subprocess.CompletedProcess[str]:
    match mode:
        case "compile-only":
            with tempfile.TemporaryDirectory(
                prefix="smolcc-test-", dir=os.environ.get("TMPDIR") or None
            ) as temp_dir:
                output_path = Path(temp_dir) / "a.o"
                return run([str(SMOLCC_PATH), "-c", "-o", str(output_path), str(path)])
        case "run":
            return run(["scripts/run", str(path), "--", *args])
        case _:
            raise ValueError(f"unsupported mode: {mode}")


def collect_case_groups(paths: list[Path]) -> list[list[Path]]:
    if paths:
        return [paths]
    all_paths = sorted(Path("tests").rglob("*.c"))
    return [
        [path for path in all_paths if "bad" not in path.parts],
        [path for path in all_paths if "bad" in path.parts],
    ]


def run_case(path: Path, update: bool) -> bool:
    print(f"==> {path} ", end="", flush=True)
    if verbosity >= Verbsity.VERBOSE:
        print()

    spec = read_spec(path)
    mode = spec.mode or "compile-only"
    args = shlex.split(spec.args) if spec.args else []
    result = run_command(path, mode, args)

    if update:
        update_spec(path, spec, result)
        print(f"{YELLOW}UPDATED{RESET}")
        return True

    want_exit = spec.exit_code
    if want_exit is None:
        want_exit = default_exit_for(path)

    actual_stderr = result.stderr.rstrip("\n")
    actual_stdout = result.stdout.rstrip("\n")
    stderr_failure, stdout_failure = None, None
    if spec.stderr is not None and actual_stderr != spec.stderr:
        stderr_failure = (spec.stderr, actual_stderr)
    if mode == "run" and spec.stdout is not None and actual_stdout != spec.stdout:
        stdout_failure = (spec.stdout, actual_stdout)

    if result.returncode != want_exit or stderr_failure or stdout_failure:
        print(f"{RED}FAIL{RESET}")
        if result.returncode != want_exit:
            print(f"Expected exit code: {want_exit}")
            print(f"Actual exit code:   {result.returncode}\n")

        if stderr_failure:
            expected, actual = stderr_failure
            print_text_block("Expected stderr", expected)
            print_text_block("Actual stderr", actual)
        else:
            print_text_block("stderr", actual_stderr)
        if stdout_failure:
            expected, actual = stdout_failure
            print_text_block("Expected stdout", expected)
            print_text_block("Actual stdout", actual)
        return False

    print(f"{GREEN}OK{RESET}")
    return True


def run_group(paths: list[Path], update: bool) -> int:
    failures = 0
    for path in paths:
        if not path.exists():
            print(f"{YELLOW}SKIP{RESET} {path} (file not found)")
        elif not run_case(path, update):
            failures += 1
    return failures


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "paths",
        nargs="*",
        type=Path,
        help="test files to run; defaults to the standard suite",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="rewrite expectations from the current compiler output",
    )
    parser.add_argument(
        "--stage",
        choices=["stage0", "stage1", "stage2"],
        help="which compiler stage to test (default: stage2)",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="skip building the compiler",
    )
    parser.add_argument(
        "--verbosity",
        choices=["normal", "verbose", "debug"],
        default="normal",
        help="set the verbosity level of test output (default: normal)",
    )

    args = parser.parse_args()
    if args.stage and args.no_build:
        print("error: --stage and --no-build cannot be used together", file=sys.stderr)
        sys.exit(1)

    args.stage = args.stage or "stage2"

    global verbosity
    verbosity = {
        "normal": Verbsity.NORMAL,
        "verbose": Verbsity.VERBOSE,
        "debug": Verbsity.DEBUG,
    }[args.verbosity]

    return args


def build_smolcc(args: argparse.Namespace):
    if not args.no_build:
        run(["make", "compiler", f"STAGE={args.stage}"], check=True)


def main() -> int:
    args = parse_args()

    build_smolcc(args)

    print("\n===> Running tests...\n")

    groups = collect_case_groups(args.paths)
    if not groups or not any(groups):
        print("No test cases found.")
        return 0

    failures = sum(run_group(group, args.update) for group in groups)

    if args.update:
        print("\nExpectations updated.")
        return 0

    if failures == 0:
        print("\nAll tests passed!")
        return 0

    print(f"\n{failures} test(s) failed!")
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
